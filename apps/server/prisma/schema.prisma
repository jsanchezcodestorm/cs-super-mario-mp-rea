generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum CampaignMode {
  SOLO
  COOP
}

enum CampaignRole {
  OWNER
  MEMBER
}

enum GameSessionStatus {
  ACTIVE
  COMPLETED
  INTERRUPTED
  ABANDONED
}

model Account {
  id             String   @id @db.Uuid
  nickname       String   @db.VarChar(24)
  nicknameKey    String   @unique @map("nickname_key") @db.VarChar(24)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ownedCampaigns Campaign[] @relation("CampaignOwner")
  memberships    CampaignMember[]
  createdInvites CampaignInvite[] @relation("InviteCreator")
  gameSessions   GameSessionParticipant[]

  @@map("accounts")
}

model Campaign {
  id                String       @id @default(uuid()) @db.Uuid
  ownerId           String       @map("owner_id") @db.Uuid
  name              String       @db.VarChar(48)
  mode              CampaignMode
  importKey         String?      @map("import_key") @db.VarChar(128)
  saveState         Json         @map("save_state") @db.JsonB
  saveFormatVersion Int          @default(2) @map("save_format_version")
  contentVersion    String       @map("content_version") @db.VarChar(64)
  revision          Int          @default(1)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    Account          @relation("CampaignOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members  CampaignMember[]
  invites  CampaignInvite[]
  sessions GameSession[]

  @@index([ownerId, updatedAt])
  @@unique([ownerId, importKey])
  @@map("campaigns")
}

model CampaignMember {
  id         String       @id @default(uuid()) @db.Uuid
  campaignId String       @map("campaign_id") @db.Uuid
  accountId  String       @map("account_id") @db.Uuid
  role       CampaignRole
  joinedAt   DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([campaignId, accountId])
  @@index([accountId, joinedAt])
  @@map("campaign_members")
}

model CampaignInvite {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  campaignId  String    @map("campaign_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  uses        Int       @default(0)
  maxUses     Int       @map("max_uses")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy Account  @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([campaignId, expiresAt, revokedAt])
  @@map("campaign_invites")
}

model GameSession {
  id             String            @id @default(uuid()) @db.Uuid
  campaignId     String            @map("campaign_id") @db.Uuid
  mode           CampaignMode
  status         GameSessionStatus
  closeReason    String?           @map("close_reason") @db.VarChar(40)
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  lastDurableAt  DateTime?         @map("last_durable_at") @db.Timestamptz(6)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)

  campaign     Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  participants GameSessionParticipant[]
  checkpoints  GameSessionCheckpoint[]

  @@index([campaignId, startedAt])
  @@map("game_sessions")
}

model GameSessionParticipant {
  id                 String         @id @default(uuid()) @db.Uuid
  gameSessionId      String         @map("game_session_id") @db.Uuid
  accountId          String         @map("account_id") @db.Uuid
  character          String         @db.VarChar(8)
  nicknameAtStart    String         @map("nickname_at_start") @db.VarChar(24)
  initialScore       Int            @default(0) @map("initial_score")
  lastCreditedScore  Int            @default(0) @map("last_credited_score")
  pointsEarned       Int            @default(0) @map("points_earned")
  startingExitIds    String[]       @default([]) @map("starting_exit_ids")
  completedExitIds   String[]       @default([]) @map("completed_exit_ids")
  maxExitCount       Int            @default(0) @map("max_exit_count")
  joinedAt           DateTime       @default(now()) @map("joined_at") @db.Timestamptz(6)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, accountId])
  @@index([accountId, gameSessionId])
  @@index([pointsEarned])
  @@index([maxExitCount])
  @@map("game_session_participants")
}

model GameSessionCheckpoint {
  id               String   @id @default(uuid()) @db.Uuid
  gameSessionId    String   @map("game_session_id") @db.Uuid
  sequence         Int
  campaignRevision Int      @map("campaign_revision")
  saveHash         String   @map("save_hash") @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  gameSession GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  @@unique([gameSessionId, sequence])
  @@unique([gameSessionId, campaignRevision])
  @@map("game_session_checkpoints")
}
