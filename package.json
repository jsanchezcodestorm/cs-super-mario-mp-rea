{
  "name": "super-mario-mp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx apps/server/src/dev.ts",
    "start": "tsx apps/server/src/main.ts",
    "build": "npm run check:server && npm run build -w @smw/web",
    "check:server": "tsc --noEmit -p apps/server/tsconfig.json",
    "test": "tsx --test tests/*.test.ts && npm run test -w @smw/core",
    "test:browser": "node tests/browser.mjs",
    "extract": "node tools/extract.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "playwright": "1.65.0",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3"
  }
}
